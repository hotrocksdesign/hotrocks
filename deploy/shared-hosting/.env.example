APP_NAME="Hot Rocks"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hotrocks.com.ar

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
# En hosting compartido normalmente es "localhost" — confirmá el valor
# exacto en la sección "MySQL Databases" / "Remote MySQL" de tu panel.
DB_HOST=localhost
DB_PORT=3306
# Reemplazá estos tres por los datos reales que te da el panel al crear
# la base — muchos hostings prefijan el nombre con tu usuario
# (ej: "usuario_hotrocks" en vez de "hotrocks").
DB_DATABASE=hotrocks
DB_USERNAME=hotrocks
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@hotrocks.com.ar
MAIL_FROM_NAME="${APP_NAME}"

INSTAGRAM_GRAPH_API_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Shop
SHOP_URL=https://hotrocks.empretienda.com.ar

# Social
INSTAGRAM_URL=https://www.instagram.com/hotrockshows/
