APP_NAME="Hot Rocks"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hotrocks
DB_USERNAME=hotrocks
DB_PASSWORD=hotrocks
DB_ROOT_PASSWORD=root

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@hotrocks.local
MAIL_FROM_NAME="${APP_NAME}"

INSTAGRAM_GRAPH_API_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Shop
SHOP_URL=https://hotrocks.empretienda.com.ar

# Social
INSTAGRAM_URL=https://www.instagram.com/hotrockshows/
